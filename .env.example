# ─────────────────────────────────────────────────────────────
#  KingLand Bureau 설정 — 이 파일을 .env.local 로 복사해서 채우세요.
#  .env.local 은 git에 올라가지 않습니다. 키 값은 채팅·메신저에 붙여 넣지 마세요.
# ─────────────────────────────────────────────────────────────

# [필수] 노션 통합 시크릿 (notion.so/profile/integrations → 새 통합 → 내부 통합 시크릿, ntn_로 시작)
NOTION_TOKEN=

# [필수] 노션 '본부' 페이지 링크 또는 32자리 ID (이 페이지에 위 통합을 연결해 두어야 함)
NOTION_ROOT_PAGE_ID=

# [필수] 앱 로그인 비밀번호 (직접 정하기). 노션 토큰이 있는데 비밀번호가 없으면 앱이 잠깁니다.
APP_PASSWORD=

# [권장] 회의실 AI 에이전트용 ChatGPT API 키 (platform.openai.com → API keys)
OPENAI_API_KEY=
# 쓸 모델 (계정에서 쓸 수 있는 모델로)
OPENAI_MODEL=gpt-5.5

# [선택] 화면에 보일 조직 이름
NEXT_PUBLIC_ORG_NAME=KingLand Bureau

# [선택] OpenAI 대신 Vercel AI Gateway를 쓸 때
# AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5

# [선택] DB를 이름으로 찾지 않고 ID로 직접 지정할 때 (보통 비워 둠)
# NOTION_AGENTS_DB_ID=
# NOTION_TASKS_DB_ID=
# NOTION_REPORTS_DB_ID=
# NOTION_TASK_REPORTS_DB_ID=
# NOTION_CHAT_DB_ID=

# [개발용] 노션 없이 가짜 AI로 흐름만 확인 (Vercel에서는 무시됨)
# SFORCE_FAKE_AI=1
